APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_DOMAIN=tunnel.example.test
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Docker Compose exposes its PostgreSQL container on host port 15432.
DATABASE_URL=postgres://tunnel:tunnel@localhost:15432/tunnel?sslmode=disable

# Provide real, unique values in production. Never commit production secrets.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
TUNNEL_SESSION_TIMEOUT=60s
TUNNEL_HEARTBEAT_INTERVAL=20s
TUNNEL_REQUEST_TIMEOUT=60s
